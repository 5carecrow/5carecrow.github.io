[
{{- $posts := where site.RegularPages "Section" "posts" -}}
{{- range $i, $p := $posts -}}
{{- if $i }},{{ end -}}
{"title":{{ $p.Title | jsonify }},"url":{{ $p.RelPermalink | jsonify }},"summary":{{ ($p.Summary | plainify) | jsonify }},"date":{{ ($p.Date.Format "2006-01-02") | jsonify }},"tags":{{ (default (slice) $p.Params.tags) | jsonify }}}
{{- end -}}
]
